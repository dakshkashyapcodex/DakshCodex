mark_tab\":true,\"show_group_filter\":true,\"show_classification_tab\":true,\"temp-sidebar-chat\":true,\"show_ai_champions_button\":true,\"show_weekly_active_users_chart\":true,\"show_project_tab\":true,\"show_benchmark\":true,\"show_connector_overview_chart\":true,\"can_see_analytics_viewer_role\":true,\"show_conversation_topic\":true,\"custom-time-range-selector\":true,\"show_impact_tab\":true},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"user_prompt_key\":\"good_option\",\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\"},\"is_device_based\":false,\"passed\":false},\"2391622925\":{\"name\":\"2391622925\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"use_backend_generated_jwt\":true,\"self_serve_business_access_token_creation_enabled\":true,\"configuration_url\":\"https://chatgpt.com/admin\"},\"is_device_based\":false,\"passed\":false},\"4005134340\":{\"name\":\"4005134340\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1007700932\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":17,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"3608673692\":{\"name\":\"3608673692\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":9,\"id_type\":\"userID\",\"value\":{\"sse_initial_open_timeout_ms\":0,\"sse_first_response_warning_ms\":120000,\"sse_between_bytes_timeout_ms\":60000},\"is_device_based\":false,\"passed\":false},\"3934129380\":{\"name\":\"3934129380\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":35,\"id_type\":\"userID\",\"value\":{\"model\":\"gpt-4o\"},\"is_device_based\":false,\"passed\":false},\"3583985244\":{\"name\":\"3583985244\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":49,\"id_type\":\"workspace_id\",\"value\":{\"permissions\":[{\"permission\":\"chatgpt.workspace.model.GPT-4.1.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-4.1-mini.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-4.5.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5-pro.access\"},{\"disable_for_quorum\":true,\"permission\":\"chatgpt.workspace.model.GPT-5-reasoning-mini.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5-reasoning.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.1-pro.access\"},{\"permission\":\"chatgpt.workspace.model.GPT-5.1-reas